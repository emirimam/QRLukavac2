{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:id([a-z0-9-]+)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/(audio|images)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
